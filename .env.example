# Local development only; change before public deployment.
POSTGRES_DB=project
POSTGRES_USER=project
POSTGRES_PASSWORD=local-dev-password
APP_PORT=8000
FSP_PORT=8001
MAILPIT_PORT=8025

# Секрет для подписи JWT. Сгенерируйте случайную строку и не коммитьте её.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Базовый URL приложения — используется в ссылках подтверждения email.
APP_BASE_URL=http://localhost:8000
# Mailpit в Docker; при запуске Python на хосте используйте localhost и SMTP-порт Mailpit.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=FSP IT Talent Match
SMTP_STARTTLS=false
SMTP_SSL=false
